# ==============================================================================
# TERRANODE IOT CONTROLLER - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this file to '.env' in the iot_controller directory to override defaults.

# General Logging & Debugging
LOG_LEVEL=INFO
CONFIG_PATH=config/system.yaml
DATABASE_URL=sqlite:///controller.db
MOCK_NODES=false
LOG_READINGS=true
LOG_RULE_EVALUATIONS=true

# Node Connection Parameters
NODE_ARDUINO_WAIT=5
NODE_MAX_RETRIES=3
NODE_TIMEOUT=12.0

# FastAPI Web Service
ENABLE_API=true
API_HOST=0.0.0.0
API_PORT=8000

# Model Context Protocol (MCP) Server
# Set ENABLE_MCP=true to activate the MCP Server module
ENABLE_MCP=true
# Transport protocol for MCP: 'sse' (embedded in FastAPI or HTTP) or 'stdio' (standalone process)
MCP_TRANSPORT=sse
# Mounting path for MCP SSE endpoints when running alongside FastAPI
MCP_PATH=/mcp
