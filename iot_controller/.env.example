# Distributed IoT Controller Environment Configuration Template

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path to main YAML system configuration file
CONFIG_PATH=config/system.yaml

# Database connection URL (SQLAlchemy standard format)
DATABASE_URL=sqlite:///controller.db

# Enable simulation mode globally (true/false)
MOCK_NODES=false

# Enable telemetry & tracing logs (true/false)
LOG_READINGS=true
LOG_RULE_EVALUATIONS=true

# Node connection defaults
NODE_ARDUINO_WAIT=5
NODE_MAX_RETRIES=3
NODE_TIMEOUT=12
