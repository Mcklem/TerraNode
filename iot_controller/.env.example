# ==============================================================================
# TERRANODE IOT CONTROLLER - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this file to '.env' in the iot_controller directory to override defaults.

# General Logging & Debugging
LOG_LEVEL=INFO
CONFIG_PATH=config/system.yaml
DATABASE_URL=sqlite:///controller.db
MOCK_NODES=false
LOG_READINGS=true
LOG_RULE_EVALUATIONS=true

# Node Connection Parameters
NODE_ARDUINO_WAIT=5
NODE_MAX_RETRIES=3
NODE_TIMEOUT=12.0

# FastAPI Web Service & Security
ENABLE_API=true
API_HOST=0.0.0.0
API_PORT=8000
# Optional API Secret Key to require authentication on FastAPI endpoints (leave empty to disable in local dev)
API_SECRET_KEY=
ENVIRONMENT=development
# Comma-separated list of allowed origins for production CORS (e.g. http://localhost:3000,http://192.168.1.50:3000)
CORS_ORIGINS=http://localhost:3000

# Storage Retention & Automatic Maintenance
DATA_RETENTION_DAYS=30
DB_AUTO_PURGE=true

# Node Hardware Authentication Keys (Interpolated into system.yaml via ${VAR_NAME})
NODE_ONE_AUTH_KEY=your_node_auth_key_here

# Multi-Channel Notifications Credentials (Interpolated into system.yaml via ${VAR_NAME})
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications (SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Model Context Protocol (MCP) Server
# Set ENABLE_MCP=true to activate the MCP Server module
ENABLE_MCP=true
# Transport protocol for MCP: 'sse' (embedded in FastAPI or HTTP) or 'stdio' (standalone process)
MCP_TRANSPORT=sse
# Mounting path for MCP SSE endpoints when running alongside FastAPI
MCP_PATH=/mcp
